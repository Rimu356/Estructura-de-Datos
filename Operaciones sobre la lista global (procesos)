// ===========================================================================
// OPERACIONES SOBRE LA LISTA GLOBAL (REGISTRO MAESTRO DE PROCESOS)
// ===========================================================================

void insertarEnListaGlobal(NodoProceso* nuevo) {
    if (listaGlobal == NULL) {
        listaGlobal = nuevo;
        return;
    }
    NodoProceso* actual = listaGlobal;
    while (actual->siguiente != NULL) {
        actual = actual->siguiente;
    }
    actual->siguiente = nuevo;
}

NodoProceso* buscarPorID(int id) {
    NodoProceso* actual = listaGlobal;
    while (actual != NULL) {
        if (actual->id == id)
            return actual;
        actual = actual->siguiente;
    }
    return NULL;
}

NodoProceso* buscarPorNombre(string subcadena) {
    NodoProceso* actual = listaGlobal;
    while (actual != NULL) {
        if (actual->nombre == subcadena)
            return actual;
        actual = actual->siguiente;
    }
    return NULL;
}

void mostrarProcesos() {
    NodoProceso* actual = listaGlobal;
    if (actual == NULL) {
        cout << "No hay procesos registrados.\n";
        return;
    }
    cout << "\n--- LISTA DE PROCESOS ---\n";
    while (actual != NULL) {
        cout << "ID: " << actual->id
             << " | Nombre: " << actual->nombre
             << " | Prioridad: " << actual->prioridad
             << " | Memoria: " << actual->memoria << " MB"
             << " | Estado: " << actual->estado << endl;
        actual = actual->siguiente;
    }
}

void eliminarDeListaGlobal(int id) {
    NodoProceso* actual = listaGlobal;
    NodoProceso* anterior = NULL;
    while (actual != NULL) {
        if (actual->id == id) {
            if (anterior == NULL)
                listaGlobal = actual->siguiente;
            else
                anterior->siguiente = actual->siguiente;
            delete actual;
            return;
        }
        anterior = actual;
        actual = actual->siguiente;
    }
}
